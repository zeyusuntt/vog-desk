# Copy to .env (git-ignored). Never commit real values.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP=vog-desk
AQS_EMAIL=
AQS_KEY=
# Optional fallback provider, existing balance only, hard cap in USD
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_CAP_USD=10
SAMPLE_MODE=false
# Local data layer (infra/compose.yml). Defaults below are local-only development values.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=vogdesk
MINIO_ROOT_PASSWORD=vogdesk-local-only
POSTGRES_USER=vogdesk
POSTGRES_PASSWORD=vogdesk-local-only
POSTGRES_DB=vogdesk
POSTGRES_PORT=5433
# Meterless memory sidecar (memory-service/), fake in-process memory when unset
MEMORY_URL=http://127.0.0.1:8790
